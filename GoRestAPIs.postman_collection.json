		{
			"name": "CreateUser",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {\r",
							"    pm.response.to.have.status(201);\r",
							"});\r",
							"\r",
							"pm.test(\"User Id is not null\", function () {\r",
							"    pm.expect(pm.response.json().id).to.not.be.null;\r",
							"});\r",
							"\r",
							"pm.test(\"User Id is a Number\", function () {\r",
							"    pm.expect(pm.response.json().id).to.be.a('number');\r",
							"});\r",
							"\r",
							"// Set the user_id environment variable\r",
							"var user_id = pm.response.json().id\r",
							"pm.environment.set(\"user_id\", user_id);\r",
							"\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Generate a unique identifier using timestamp and a random number\r",
							"var uniqueId = new Date().getTime() + Math.floor(Math.random() * 1000);\r",
							"\r",
							"// Create the unique email\r",
							"var uniqueEmail = \"susmitha\" + uniqueId + \"@gmail.com\";\r",
							"\r",
							"// Set the unique email in an environment variable\r",
							"pm.environment.set(\"uniqueEmail\", uniqueEmail);\r",
							"\r",
							"console.log(uniqueEmail)\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "{{AuthToken}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\"name\":\"PradeepRS\", \"gender\":\"male\", \"email\": \"{{uniqueEmail}}\", \"status\":\"active\"}\r\n",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{BaseURL_GoRest}}public/v2/users",
					"host": [
						"{{BaseURL_GoRest}}public"
					],
					"path": [
						"v2",
						"users"
					]
				}
			},
			"response": []
